<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for BTBridge's pure rules (BTBridge.Logic). Same runtime target as the mod. Game
       assemblies are referenced for compilation only; tests must not touch game types. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\BATTLETECH</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BTBridge\BTBridge.csproj" />
  </ItemGroup>

</Project>
